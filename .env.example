# Copy to .env. Never commit it.
OPENAI_API_KEY=
# Stop new interviews when AI spending in Leo reaches this many US dollars.
BUDGET_USD=2.5
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_HOUR=20
# Voice: "mumbai" (AWS Transcribe, Bedrock, Polly) or "openai" (needs OPENAI_API_KEY).
VOICE_ROUTE=openai
BEDROCK_MODEL_ID=mistral.ministral-3-8b-instruct
BEDROCK_SCORING_MODEL_ID=deepseek.v3.2
# Who can use the hidden admin login, comma separated.
# ADMIN_EMAILS=
# Set automatically on AWS:
# LEO_ENV=production
# LEO_SECRET=
# LEO_BASE_URL=
# DATABASE_URL=postgresql+psycopg://leo:password@127.0.0.1/leo
# SES_FROM=
# AWS_REGION=ap-south-1
